<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamic_obstacle_avoidance</name>
  <version>0.0.0</version>
  <description>Rule-based LiDAR centerline obstacle avoidance with E2E handoff.</description>
  <maintainer email="xytron@todo.todo">xytron</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>xycar_lidar</exec_depend>
  <exec_depend>xycar_motor</exec_depend>
  <exec_depend>xycar_cam</exec_depend>
  <exec_depend>lane_drive</exec_depend>
  <exec_depend>track_drive</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
